# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database driver
# - sqlite : zero-config local file (recommended for dev)
# - mysql  : real MySQL server (recommended for production)
DB_DRIVER=sqlite
SQLITE_FILE=./data/workpulse.db

# MySQL (used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workpulse

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
